<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- xUnit1051: CancellationToken on awaited store calls — not relevant for these tests. -->
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Graphics" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.FaceIntelligence\Shiny.FaceIntelligence.csproj" />
        <ProjectReference Include="..\..\src\Shiny.FaceIntelligence.DocumentDb.Sqlite\Shiny.FaceIntelligence.DocumentDb.Sqlite.csproj" />
        <ProjectReference Include="..\Shiny.FaceIntelligence.TestKit\Shiny.FaceIntelligence.TestKit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Linked .Maui sources that need no Controls/platform: the analyzer (camera base class stubbed in
             FaceRecognitionContinuityTests.cs — keep that stub in step with Shiny.Maui.Controls.Camera), the
             enrollment run, bitmap conversion and guide geometry. -->
        <Compile Include="../../src/Shiny.FaceIntelligence.Maui/FaceFrameObservation.cs" Link="Camera/FaceFrameObservation.cs" />
        <Compile Include="../../src/Shiny.FaceIntelligence.Maui/FaceRecognitionAnalyzer.cs" Link="Camera/FaceRecognitionAnalyzer.cs" />
        <Compile Include="../../src/Shiny.FaceIntelligence.Maui/FaceRecognizedEventArgs.cs" Link="Camera/FaceRecognizedEventArgs.cs" />
        <Compile Include="../../src/Shiny.FaceIntelligence.Maui/AnalyzedFace.cs" Link="Camera/AnalyzedFace.cs" />
        <Compile Include="../../src/Shiny.FaceIntelligence.Maui/Internals/FrameQuality.cs" Link="Camera/FrameQuality.cs" />
        <Compile Include="../../src/Shiny.FaceIntelligence.Maui/FaceEnrollmentCapture.cs" Link="Enrollment/FaceEnrollmentCapture.cs" />
        <Compile Include="../../src/Shiny.FaceIntelligence.Maui/Internals/FaceEnrollmentRun.cs" Link="Enrollment/FaceEnrollmentRun.cs" />
        <Compile Include="../../src/Shiny.FaceIntelligence.Maui/Internals/FrameImageConverter.cs" Link="Imaging/FrameImageConverter.cs" />
        <!-- Pure geometry (FaceGuide + drawable): Microsoft.Maui.Graphics only, no Controls/platform. -->
        <Compile Include="../../src/Shiny.FaceIntelligence.Maui/FaceGuide.cs" Link="Geometry/FaceGuide.cs" />
        <Compile Include="../../src/Shiny.FaceIntelligence.Maui/Internals/FaceGuideDrawable.cs" Link="Geometry/FaceGuideDrawable.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- sqlite-vec native binary for the vector integration tests. Only the OS+arch of the
             current dev box is committed; CI should download/provision per-platform. -->
        <None Include="..\runtimes\osx-arm64\native\vec0.dylib" Condition="Exists('..\runtimes\osx-arm64\native\vec0.dylib')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>vec0.dylib</Link>
        </None>
    </ItemGroup>

</Project>
