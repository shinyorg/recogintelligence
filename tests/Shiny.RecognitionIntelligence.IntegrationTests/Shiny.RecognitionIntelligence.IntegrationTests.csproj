<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- xUnit1051: CancellationToken on awaited store calls — not relevant for these tests. -->
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

    <!-- Both stacks + both TestKits: these tests prove the face and voice pipelines COMPOSE in one
         app/container without their DocumentDb stores colliding. -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.FaceIntelligence.DocumentDb.Sqlite\Shiny.FaceIntelligence.DocumentDb.Sqlite.csproj" />
        <ProjectReference Include="..\..\src\Shiny.VoiceIntelligence.DocumentDb.Sqlite\Shiny.VoiceIntelligence.DocumentDb.Sqlite.csproj" />
        <ProjectReference Include="..\Shiny.FaceIntelligence.TestKit\Shiny.FaceIntelligence.TestKit.csproj" />
        <ProjectReference Include="..\Shiny.VoiceIntelligence.TestKit\Shiny.VoiceIntelligence.TestKit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- sqlite-vec native binary for the vector integration tests. Shared with the face/voice suites;
             only the OS+arch of the current dev box is committed — CI provisions per-platform. -->
        <None Include="..\runtimes\osx-arm64\native\vec0.dylib" Condition="Exists('..\runtimes\osx-arm64\native\vec0.dylib')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>vec0.dylib</Link>
        </None>
    </ItemGroup>

</Project>
