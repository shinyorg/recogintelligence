<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cam="http://shiny.net/maui/camera"
             xmlns:vm="clr-namespace:Sample.ViewModels"
             x:Class="Sample.Pages.EnrollPage"
             x:DataType="vm:EnrollViewModel"
             Title="Enroll">

    <Grid RowDefinitions="*,Auto">
        <cam:CameraView x:Name="Camera"
                        Grid.Row="0"
                        Facing="Front"
                        ScaleMode="AspectFill"
                        DetectionCaptured="OnDetectionCaptured">
            <cam:FaceAnalyzer IsEnabled="True"
                              CaptureOnDetection="True"
                              ShowBoundingBox="True" />
        </cam:CameraView>

        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="10">
            <Entry Text="{Binding Name}" Placeholder="Name" ReturnType="Done" />
            <Button Text="Capture &amp; Enroll"
                    Command="{Binding EnrollCommand}" />
            <Label Text="{Binding StatusText}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
