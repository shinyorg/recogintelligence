<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.ViewModels"
             x:Class="Sample.Pages.PeoplePage"
             x:DataType="vm:PeopleViewModel"
             Title="People">

    <Grid RowDefinitions="*,Auto">
        <CollectionView Grid.Row="0" ItemsSource="{Binding People}">
            <CollectionView.EmptyView>
                <Label Text="No one enrolled yet. Use the Enroll tab."
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PersonRow">
                    <Grid Padding="16,10" ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
                        <Image Grid.Column="0" Source="{Binding Thumb}"
                               WidthRequest="56" HeightRequest="56" Aspect="AspectFill" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="17" />
                            <Label Text="{Binding CountText}" FontSize="13" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Forget"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PeopleViewModel}}, Path=ForgetCommand}"
                                CommandParameter="{Binding Name}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1" Padding="16" Text="{Binding StatusText}" />
    </Grid>

</ContentPage>
