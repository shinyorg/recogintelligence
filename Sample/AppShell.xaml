<?xml version="1.0" encoding="UTF-8" ?>
<shiny:ShinyShell
    x:Class="Sample.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Shell"
    xmlns:pages="clr-namespace:Sample.Pages"
    Title="Faces">

    <TabBar>
        <ShellContent
            Title="Recognize"
            ContentTemplate="{DataTemplate pages:RecognizePage}"
            Route="Recognize" />
        <ShellContent
            Title="Enroll"
            ContentTemplate="{DataTemplate pages:EnrollPage}"
            Route="Enroll" />
        <ShellContent
            Title="People"
            ContentTemplate="{DataTemplate pages:PeoplePage}"
            Route="People" />
        <ShellContent
            Title="Scan"
            ContentTemplate="{DataTemplate pages:ScanPage}"
            Route="Scan" />
    </TabBar>

</shiny:ShinyShell>
