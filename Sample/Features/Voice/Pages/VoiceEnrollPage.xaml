<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Shell"
             xmlns:vi="clr-namespace:Shiny.VoiceIntelligence.Maui;assembly=Shiny.VoiceIntelligence.Maui"
             xmlns:vm="clr-namespace:Sample.Features.Voice.Pages"
             x:Class="Sample.Features.Voice.Pages.VoiceEnrollPage"
             x:DataType="vm:VoiceEnrollViewModel"
             Title="Voice Enroll">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home"
                     shiny:Navigate.Route="Home"
                     shiny:Navigate.RelativeNavigation="False" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- The wizard: sentence list, countdown, recording, quality gating and the decision about when
                 there are enough agreeing recordings all live in the control. It keeps going until the
                 voiceprints agree — the page only starts it and reports the outcome. -->
            <vi:VoiceEnrollmentView x:Name="VoiceEnroller"
                                    PersonIdentifier="{Binding Name}"
                                    Completed="OnCompleted"
                                    Failed="OnFailed" />

            <Entry Text="{Binding Name}"
                   Placeholder="Name"
                   ReturnType="Done"
                   IsVisible="{Binding IsNotEnrolling}" />

            <Button Text="Start voice enrollment"
                    Clicked="OnStartClicked"
                    IsVisible="{Binding IsNotEnrolling}" />

            <Button Text="Cancel"
                    Clicked="OnCancelClicked"
                    IsVisible="{Binding IsEnrolling}" />

            <Label Text="{Binding StatusText}" HorizontalTextAlignment="Center" />

            <Label Text="Tip: same room, same distance from the mic, speak naturally. Nothing is saved until the wizard is satisfied."
                   FontSize="12" Opacity="0.6" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
