<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Shell"
             xmlns:vm="clr-namespace:Sample.Features.Voice.Pages"
             x:Class="Sample.Features.Voice.Pages.VoiceEnrollPage"
             x:DataType="vm:VoiceEnrollViewModel"
             Title="Voice Enroll">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home"
                     shiny:Navigate.Route="Home"
                     shiny:Navigate.RelativeNavigation="False" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Entry Text="{Binding Name}" Placeholder="Name" ReturnType="Done" IsEnabled="{Binding IsIdle}" />

        <!-- Read-aloud prompt. The model is text-independent, so this is a phonetically rich sentence
             (not a passphrase) to get a stronger voiceprint; the VM rotates it each recording. -->
        <Border Padding="16" StrokeThickness="1" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="6">
                <Label Text="READ ALOUD WHILE RECORDING" FontSize="12" Opacity="0.6" />
                <Label Text="{Binding PromptText}" FontSize="20" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Border>

        <Button Text="Record &amp; Enroll"
                Command="{Binding RecordCommand}"
                IsEnabled="{Binding IsIdle}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Label Text="{Binding StatusText}" HorizontalTextAlignment="Center" />
        <Label Text="Tip: speak naturally at a normal distance. Enroll 3–4 times — the prompt changes each time to cover more sounds."
               FontSize="12" Opacity="0.6" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>

</ContentPage>
