<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Features.Voice.Pages"
             x:Class="Sample.Features.Voice.Pages.SpeakersPage"
             x:DataType="vm:SpeakersViewModel"
             Title="Speakers">

    <Grid RowDefinitions="*,Auto">
        <CollectionView Grid.Row="0" ItemsSource="{Binding Speakers}">
            <CollectionView.EmptyView>
                <Label Text="No speakers enrolled yet. Use the Voice Enroll tab."
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SpeakerRow">
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="17" />
                            <Label Text="{Binding CountText}" FontSize="13" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Forget"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SpeakersViewModel}}, Path=ForgetCommand}"
                                CommandParameter="{Binding Name}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1" Padding="16" Text="{Binding StatusText}" />
    </Grid>

</ContentPage>
