<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cam="http://shiny.net/maui/camera"
             xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Shell"
             xmlns:vm="clr-namespace:Sample.Features.Face.Pages"
             x:Class="Sample.Features.Face.Pages.EnrollPage"
             x:DataType="vm:EnrollViewModel"
             Title="Enroll">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home"
                     shiny:Navigate.Route="Home"
                     shiny:Navigate.RelativeNavigation="False" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <cam:CameraView x:Name="Camera"
                        Grid.Row="0"
                        Facing="Front"
                        ScaleMode="AspectFill">
            <cam:FaceAnalyzer x:Name="FaceDetector"
                              IsEnabled="True"
                              ShowBoundingBox="True"
                              FacesDetected="OnFacesDetected" />
        </cam:CameraView>

        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="10">
            <Entry Text="{Binding Name}" Placeholder="Name" ReturnType="Done" />
            <Button Text="Capture &amp; Enroll"
                    Clicked="OnEnrollClicked" />
            <Label Text="{Binding StatusText}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
