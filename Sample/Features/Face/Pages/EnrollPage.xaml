<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fi="clr-namespace:Shiny.FaceIntelligence.Maui;assembly=Shiny.FaceIntelligence.Maui"
             xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Shell"
             xmlns:vm="clr-namespace:Sample.Features.Face.Pages"
             x:Class="Sample.Features.Face.Pages.EnrollPage"
             x:DataType="vm:EnrollViewModel"
             Title="Enroll">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home"
                     shiny:Navigate.Route="Home"
                     shiny:Navigate.RelativeNavigation="False" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <!-- The wizard: prompts, per-step gating and the instruction overlay all live in the control. It
             enrolls from the analyzed frame, so templates match what recognition sees. -->
        <fi:FaceEnrollmentView x:Name="FaceCamera"
                               Grid.Row="0"
                               PersonIdentifier="{Binding Name}"
                               Completed="OnCompleted"
                               CameraFailed="OnCameraFailed" />

        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="10">
            <Entry Text="{Binding Name}" Placeholder="Name" ReturnType="Done" />
            <Button Text="Start guided enrollment" Clicked="OnStartClicked" />
            <Label Text="{Binding StatusText}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
