<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cam="http://shiny.net/maui/camera"
             xmlns:vm="clr-namespace:Sample.Features.Face.Pages"
             x:Class="Sample.Features.Face.Pages.RecognizePage"
             x:DataType="vm:RecognizeViewModel"
             Title="Recognize">

    <Grid>
        <!-- Live preview. The FaceAnalyzer detects faces on-device; we capture a still ourselves off
             FacesDetected (the CaptureOnDetection/DetectionCaptured path doesn't fire on iOS in this beta). -->
        <cam:CameraView x:Name="Camera"
                        Facing="Front"
                        ScaleMode="AspectFill">
            <cam:FaceAnalyzer IsEnabled="True"
                              ShowBoundingBox="True"
                              FacesDetected="OnFacesDetected" />
        </cam:CameraView>

        <Border VerticalOptions="End"
                Margin="16"
                Padding="16,12"
                BackgroundColor="#CC000000"
                StrokeShape="RoundRectangle 14">
            <Label Text="{Binding ResultText}"
                   TextColor="White"
                   FontSize="18"
                   HorizontalTextAlignment="Center" />
        </Border>
    </Grid>

</ContentPage>
