<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Shell"
             xmlns:vm="clr-namespace:Sample.Features.Documents.Pages"
             x:Class="Sample.Features.Documents.Pages.ScanPage"
             x:DataType="vm:ScanViewModel"
             Title="Scan">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home"
                     shiny:Navigate.Route="Home"
                     shiny:Navigate.RelativeNavigation="False" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="12">
        <Picker Grid.Row="0"
                Title="Document type"
                ItemsSource="{Binding DocumentTypes}"
                SelectedItem="{Binding SelectedDocumentType}" />

        <Button Grid.Row="1"
                Text="Scan &amp; Extract"
                Command="{Binding ScanCommand}" />

        <!-- The captured pages are a thumbnail strip: on this screen the parsed result is the subject, and
             the images are the evidence you glance at when a field looks wrong. -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Pages}"
                        IsVisible="{Binding HasPages}"
                        HeightRequest="150">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ImageSource">
                    <Border Stroke="#22000000" StrokeShape="RoundRectangle 8">
                        <Image Source="{Binding .}" Aspect="AspectFit" WidthRequest="110" HeightRequest="146" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ScrollView Grid.Row="3">
            <VerticalStackLayout Spacing="12">
                <Label Text="No pages yet. Pick a type and scan a document."
                       IsVisible="{Binding HasNoSections}"
                       HorizontalOptions="Center" Margin="0,24" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ParsedSection">
                            <Border Stroke="#22000000" StrokeShape="RoundRectangle 8" Padding="12">
                                <VerticalStackLayout Spacing="6">
                                    <!-- Title plus the .NET type the extractor actually produced. -->
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                                        <Label Text="{Binding TypeName}"
                                               IsVisible="{Binding HasTypeName}"
                                               FontFamily="Monospace" FontSize="12" TextColor="Gray"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}" Spacing="3">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ParsedField">
                                                <Grid ColumnDefinitions="140,*" ColumnSpacing="8"
                                                      Margin="{Binding IndentMargin}">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           FontSize="13" TextColor="Gray"
                                                           LineBreakMode="WordWrap" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding Display}"
                                                           FontSize="13" FontFamily="Monospace">
                                                        <Label.Triggers>
                                                            <!-- Missing reads as absent; a failed checksum or an
                                                                 expired card reads as wrong. Different things. -->
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding IsMissing}" Value="True">
                                                                <Setter Property="TextColor" Value="#9E9E9E" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="TextColor" Value="#C62828" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Raw OCR text: demoted, not dropped. It's how you tell a parsing miss from an OCR miss. -->
                <Button Text="{Binding RawTextButtonText}"
                        Command="{Binding ToggleRawTextCommand}"
                        IsVisible="{Binding HasRawText}" />

                <Border IsVisible="{Binding ShowRawText}"
                        Stroke="#22000000" StrokeShape="RoundRectangle 8" Padding="12">
                    <Label Text="{Binding RawText}" FontFamily="Monospace" FontSize="12" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Label Grid.Row="4" Text="{Binding StatusText}" HorizontalTextAlignment="Center" />
    </Grid>

</ContentPage>
