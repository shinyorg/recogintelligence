<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- MAUI, so the TFM set matches the face controls package. There is deliberately NO per-platform
             code here: unlike face — where a camera frame arrives as a native buffer that has to be
             converted per OS — this control never touches audio hardware. Recording is supplied by the app
             through IVoiceRecorder, which keeps the "this library captures no audio" rule that put
             VoiceEnrollmentSession in core in the first place. -->
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <UseMaui>true</UseMaui>
        <Description>Guided voice enrollment as a MAUI control: shows a set of sentences to read, records each one, and keeps going until the stored voiceprints agree well enough to be worth matching against.</Description>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Shiny.VoiceIntelligence/Shiny.VoiceIntelligence.csproj" />
        <!-- Explicit: unlike the face controls package, nothing else here drags MAUI in transitively
             (that one gets it via Shiny.Maui.Controls.Camera). Version comes from CPM. -->
        <PackageReference Include="Microsoft.Maui.Controls" />
    </ItemGroup>

</Project>
